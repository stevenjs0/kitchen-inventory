# Supabase (managed cloud)
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local Supabase (for development only)
# La app ignora estas variables cuando NODE_ENV=production.
# Deben usar el prefijo NEXT_PUBLIC_ para que el browser y el server
# apunten a la misma instancia.
NEXT_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_LOCAL_ANON_KEY=your-local-anon-key

# Solo para scripts/ (server-side; nunca prefixear con NEXT_PUBLIC_):
# La service role key bypasea RLS: nunca debe llegar al browser.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_SERVICE_ROLE_KEY=your-local-service-role-key

# Google OAuth configuration
# Configure in Supabase Dashboard: Authentication → Providers → Google
# Not needed as env vars for managed Supabase
