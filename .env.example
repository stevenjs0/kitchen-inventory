# Supabase (managed cloud)
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ⚠️ NEVER prefix with NEXT_PUBLIC_ — this key bypasses RLS and must stay server-side only

# Local Supabase (for development only)
# Nombres canónicos en el código (src/lib/supabase/config.ts):
NEXT_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_LOCAL_ANON_KEY=your-local-anon-key
# Alias legacy, aún aceptado por las fábricas server:
# SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# SUPABASE_LOCAL_ANON_KEY=your-local-anon-key
# Solo lo usan scripts/ (server-side; nunca prefixear con NEXT_PUBLIC_):
SUPABASE_LOCAL_SERVICE_ROLE_KEY=your-local-service-role-key

# Google OAuth configuration
# Configure in Supabase Dashboard: Authentication → Providers → Google
# Not needed as env vars for managed Supabase
